# Copy to .env.bibe-local, then replace every value before starting.
# Do not commit .env.bibe-local. This stack binds only to loopback.
BIBE_LOCAL_PORT=8088
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
JWT_SECRET=

# Optional: use exact pre-built image tags instead of locally built images.
# BIBE_WEB_IMAGE=ghcr.io/samarun/openreview-studio-web:sha-<commit>
# BIBE_API_IMAGE=ghcr.io/samarun/openreview-studio-api:sha-<commit>
# BIBE_WORKER_IMAGE=ghcr.io/samarun/openreview-studio-worker:sha-<commit>
